# Ethical Voice Clone TTS — Configuration
# Storage directory for enrolled speaker profiles and consent certificates
VOICE_PROFILES_DIR=voices

# Sampling rate (Hz)
SAMPLE_RATE=22050

# Provenance watermark strength (0.001 to 0.05)
WATERMARK_STRENGTH=0.015

# Organization identifier injected into provenance records
WATERMARK_ORG=Vecesta.co
